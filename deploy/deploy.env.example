# Zkopírujte do deploy/deploy.env a vyplňte. deploy.sh čte jen tento soubor.

# SSH cíl pro ssh/rsync, např. deploy@drivko.shop
SSH_TARGET="user@server.example.com"

# Kde projekt na serveru leží
REMOTE_PATH="/srv/drivko-kremacia"

COMPOSE_FILE="docker-compose.prod.yml"

# Jméno PHP-FPM kontejneru – musí se lišit od e-shopu (drievko_app)
APP_CONTAINER="kremacia_app"

# Port PHP-FPM na localhostu serveru – 9000 používá e-shop
PHP_FPM_PORT="9001"

# Volitelný reload nginx po nasazení
RELOAD_NGINX="false"
NGINX_RELOAD_COMMAND="sudo systemctl reload nginx"

# Volitelně další vzory pro rsync --exclude, oddělené mezerou
EXTRA_RSYNC_EXCLUDES=""
