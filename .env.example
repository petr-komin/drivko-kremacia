APP_NAME="Drivko – urny"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokálně kontejner "db" z docker-compose.yml.
# Na produkci PostgreSQL na hostu: DB_HOST=host.docker.internal
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kremacia
DB_USERNAME=kremacia
DB_PASSWORD=secret

SESSION_DRIVER=database
# Přihlášení vydrží týden – lidé na kremaci se nemají co chvíli přihlašovat
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Na produkci s HTTPS: true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Lokálně se e-maily jen zapisují do storage/logs/laravel.log.
# Na produkci Brevo API jako e-shop (stejný účet, doména drivko.shop je v Brevo ověřená):
#   MAIL_MAILER=brevo
#   BREVO_API_KEY=<Brevo → Settings → API Keys>
# Lokálně MAIL_MAILER=log – e-maily jen do storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="urny@drivko.shop"
MAIL_FROM_NAME="Drivko urny"

# Kam chodí upozornění na nové zakázky a zprávy od kremace (víc adres oddělte čárkou).
# Prázdné = upozornění dostanou všichni administrátoři.
NOTIFY_ADMIN_EMAILS=
BREVO_API_KEY=

# Administrátor zakládaný seederem (php artisan db:seed)
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
